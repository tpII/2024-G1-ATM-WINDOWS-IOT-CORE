<Page
    x:Class="RFIDForIoT.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RFIDForIoT"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FFEEF2F3">
    <!-- Fondo gris claro -->

    <Grid>
        <!-- Título -->
        <TextBlock 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top" 
            Margin="0,30,0,0" 
            Text="Lector de Tarjetas RFID"
            FontSize="30" 
            FontWeight="Bold"
            Foreground="#333"/>

        <!-- Contenedor principal -->
        <Border Margin="50,100,50,50" Background="#FFFFFF" CornerRadius="10" Padding="20">
            <StackPanel>
                <!-- Etiqueta -->
                <TextBlock 
                    HorizontalAlignment="Left" 
                    Margin="0,0,0,10" 
                    Text="ID Detectado:" 
                    FontSize="20" 
                    FontWeight="SemiBold"
                    Foreground="#444"/>

                <!-- Caja para el código de la tarjeta -->
                <Border 
                    Background="#F0F8FF" 
                    CornerRadius="5" 
                    Padding="10" 
                    HorizontalAlignment="Stretch">
                    <TextBlock 
                        Name="OutputBox" 
                        Text="Esperando tarjeta..." 
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#0078D7" 
                        TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Pie de página -->
        <TextBlock 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Margin="0,20,0,0" 
            Text="Sistema RFID - Proyecto IoT"
            FontSize="16" 
            FontStyle="Italic"
            Foreground="#555"/>
    </Grid>
</Page>
