@page
@model ATM.UI.Pages.EnterPinModel
@{
    ViewData["Title"] = "Enter Pin";
}

<h1 class="display-4">Ingrese el pin de la tarjeta</h1>

<form method="post">
    <div>
        <label for="pin">PIN</label>
        <input type="password" id="pin" name="Pin" asp-for="Pin" required />
    </div>
    <button type="submit">Confirmar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}
