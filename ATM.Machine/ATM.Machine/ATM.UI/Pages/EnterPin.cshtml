@page
@model ATM.UI.Pages.EnterPinModel
@{
    ViewData["Title"] = "Ingreso de PIN";
}

<h1>Ingrese su PIN</h1>
<p class="lead">Por favor, ingrese su PIN usando el teclado numérico.</p>

<div id="notification" class="alert alert-info d-none">
    Ha sido redirigido por inactividad.
</div>

<form method="post" id="pin-form">
    <input type="password" id="pin" name="pin" asp-for="Pin" maxlength="4" class="form-control mb-3" placeholder="****" autofocus />
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

<script src="~/js/activity.js"></script>
