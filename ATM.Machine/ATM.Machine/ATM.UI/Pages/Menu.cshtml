@page
@model ATM.UI.Pages.MenuModel
@{
    ViewData["Title"] = "Menú de Operaciones";
}

<div class="menu-container">
    <h1>Menú de Operaciones</h1>
    <div class="button-container">
        <a class="btn-operation" href="/Deposit">Depositar</a>
        <a class="btn-operation" href="/Withdraw">Retirar</a>
        <a class="btn-operation" href="/Transfer">Transferir</a>
        <a class="btn-operation" href="/CheckBalance">Ver Balance</a>
        <form method="post" asp-page-handler="LogOut" class="form-button">
            <button type="submit" class="btn-operation logout">Salir</button>
        </form>
    </div>
</div>

<script src="~/js/activity.js"></script>