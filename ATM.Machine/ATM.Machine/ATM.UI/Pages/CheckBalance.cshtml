@page
@model ATM.UI.Pages.CheckBalanceModel
@{
    ViewData["Title"] = "Check Balance";
}

<h1>Balance</h1>

@if (Model.Balance.HasValue)
{
    <p class="info">Saldo actual en tu cuenta: $@Model.Balance</p>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<a asp-page="/Menu" class="mt-3 btn btn-primary">Regresar al Menú</a>