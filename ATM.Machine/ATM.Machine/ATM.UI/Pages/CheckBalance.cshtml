@page
@model ATM.UI.Pages.CheckBalanceModel
@{
    ViewData["Title"] = "Check Balance";
}

<h1>Balance</h1>

@if (Model.Balance.HasValue)
{
    <p>Your account balance is: @Model.Balance</p>
}

<a asp-page="/Menu" class="mt-3 btn btn-secondary">Regresar al Menu</a>

@if (!string.IsNullOrEmpty(Model.ErrorMessage)) 
{
    <p style="color: red;">@Model.ErrorMessage</p>
}