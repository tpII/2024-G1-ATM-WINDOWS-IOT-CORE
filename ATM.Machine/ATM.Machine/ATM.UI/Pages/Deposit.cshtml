@page
@model ATM.UI.Pages.DepositModel
@{
    ViewData["Title"] = "Deposit";
}

<h1>Deposit Money</h1>

<form method="post">
    <label for="amount">Amount:</label>
    <input type="number" id="amount" name="Amount" asp-for="Amount" step="0.01" min="0.01" required />
    <br />
    <button type="submit">Deposit</button>
</form>

<a asp-page="/Menu" class="mt-3 btn btn-secondary">Regresar al Menu</a>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <p style="color: green;">@Model.SuccessMessage</p>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color: red;">@Model.ErrorMessage</p>
}
