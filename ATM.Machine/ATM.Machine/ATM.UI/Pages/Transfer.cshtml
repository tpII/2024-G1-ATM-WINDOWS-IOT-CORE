@page
@model ATM.UI.Pages.TransferModel
@{
    ViewData["Title"] = "Transfer";
}

<h1>Transfer Money</h1>

<form method="post">
    <label for="destinationCbu">Destination CBU:</label>
    <input type="text" id="destinationCbu" name="DestinationCbu" asp-for="DestinationCbu" required />
    <br />
    <label for="amount">Amount:</label>
    <input type="number" id="amount" name="Amount" asp-for="Amount" step="0.01" min="0.01" required />
    <br />
    <button type="submit">Transfer</button>
</form>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <p style="color: green;">@Model.SuccessMessage</p>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p style="color: red;">@Model.ErrorMessage</p>
}
