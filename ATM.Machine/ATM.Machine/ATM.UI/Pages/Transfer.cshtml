@page
@model ATM.UI.Pages.TransferModel
@{
    ViewData["Title"] = "Transferencia";
}

<h1>Transferencia</h1>

<form method="post">
    <div class="form-group">
        <label class="form-label" for="DestinationCbu">CBU de la cuenta destino:</label>
        <input type="text" id="DestinationCbu" name="DestinationCbu" asp-for="DestinationCbu" class="form-control" required />
    </div>
    <div class="form-group">
        <label class="form-label" for="Amount">Monto a transferir:</label>
        <input type="number" id="Amount" name="Amount" asp-for="Amount" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Confirmar</button>
        <a asp-page="/Menu" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
<div>
    <span asp-validation-summary="ModelOnly" class="text-danger"></span>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<script src="~/js/activity.js"></script>